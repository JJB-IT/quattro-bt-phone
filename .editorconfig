root = true

[*]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
charset = utf-8

# rustfmt's standard; everything else follows Omarchy's 2-space style.
[*.rs]
indent_size = 4

# Markdown lists and ASCII diagrams need free-form indentation.
[*.md]
indent_size = unset
